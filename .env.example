# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Network — must be one of: polygon, amoy
NETWORK=polygon

# Supabase — required at boot
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase publishable key — required by GET /v1/config/public, the
# bootstrap endpoint public clients (SDK, CLI) hit to obtain Realtime
# credentials. Endpoint returns 503 until this is set; the rest of the
# API still boots without it. New ("sb_publishable_…") and legacy JWT
# anon-key formats are both accepted.
SUPABASE_ANON_KEY=

# RPC — required by GET /v1/positions/by-tx/:txHash and
# GET /v1/positions/claim-result/:txHash for tx-receipt parsing.
ALCHEMY_RPC_URL=

# MatchingModule — required by POST /v1/commitments (verifyingContract
# of the EIP-712 domain) AND by the M3 stream-auth handlers, which reuse
# the address as verifyingContract of the separate OspexStreamAuth domain.
# Format-validated when set.
MATCHING_MODULE_ADDRESS=

# PositionModule — optional defensive log-source filter for tx parsers.
# When set, /v1/positions/by-tx and /v1/positions/claim-result only
# decode logs originating from this contract. Format-validated when set.
POSITION_MODULE_ADDRESS=

# Scorer addresses — required by POST /v1/commitments to map a signed
# commitment's `scorer` field to a market_type. All three must be set
# together; a partial config is rejected at boot.
SCORER_MONEYLINE_ADDRESS=
SCORER_SPREAD_ADDRESS=
SCORER_TOTAL_ADDRESS=

# SSE concurrent-connection caps. SSE streams are long-lived, so the request
# rate limiter doesn't apply — these caps bound how many streams the process
# (and a single IP) can hold open at once. Optional; defaults shown. TOTAL and
# PER_IP must be a positive integer; the owner reserve below may also be 0 (a
# negative / non-integer value exits at boot).
# Per-IP is per egress IP/host, shared across all clients behind it. Co-locating
# N market-maker instances on one host must satisfy BOTH per-IP constraints:
#   - overall:    N * (odds channels + 1)  <= PER_IP
#   - anon odds:  N * (odds channels)      <= PER_IP - RESERVED_..._PER_IP_OWNER
# The anon-odds constraint is usually the BINDING one (the reserve shrinks the
# anonymous budget below the total cap), so size PER_IP for it. Example: PER_IP=16,
# reserve=3, N=2, odds=7 passes the overall check (2*8=16 <= 16) but the anon check
# rejects the 14th odds stream (2*7=14 > 16-3=13) — raise PER_IP (or lower N / odds
# / reserve).
MAX_STREAM_CONNECTIONS_TOTAL=200
MAX_STREAM_CONNECTIONS_PER_IP=16
# Of the per-IP budget, how many slots are reserved for the owner-authenticated
# own-state stream — anonymous public streams (odds/protocol) may use at most
# (PER_IP - this), while own-state may use the full PER_IP. Prevents anonymous
# saturation from 429-ing a market-maker's safety-critical own-state reconnect.
# 0 = no reserve (the original single shared pool: anonymous + own-state share the
# full PER_IP). Optional; default shown.
RESERVED_STREAM_CONNECTIONS_PER_IP_OWNER=3

# Public hidden-row redaction (M2). Default true; setting "false" reverts every
# anonymous read path to the legacy "full body for all rows" behavior — for
# rollback during a deploy window only. Slated for removal post-M7 cutover.
REDACT_HIDDEN_PUBLIC=true

# Stream-auth (M3). All three required for POST /v1/auth/stream-challenge,
# POST /v1/auth/stream-token, and the verifyStreamToken middleware — both
# endpoints return 503 NOT_READY until they're set. MATCHING_MODULE_ADDRESS
# above is also required (the EIP-712 domain reuses it as verifyingContract).
#
# STREAM_AUTH_HMAC_SECRET: HMAC-SHA256 secret used to sign + verify bearer
# tokens. Must be at least 32 characters of entropy (boot-time fatal otherwise).
# Treat as a secret on par with SUPABASE_SERVICE_ROLE_KEY.
STREAM_AUTH_HMAC_SECRET=
# STREAM_AUTH_AUDIENCE: canonical deployment host string (e.g.
# "https://ospex-core-api-195f635df864.herokuapp.com"). Bound into both the
# challenge typed-data and issued token so a token minted for one deployment
# can never be replayed against another.
STREAM_AUTH_AUDIENCE=
# Challenge TTL (seconds) — bounded 120..300 per spec §3.3 (2–5 min). Default 180.
STREAM_CHALLENGE_TTL_SECONDS=180
# Token TTL (seconds) — bounded 60..1800 (1 min – 30 min). Default 900 (15 min).
STREAM_TOKEN_TTL_SECONDS=900

# Own-state snapshot (M4a): per-page commitments cap for
# GET /v1/own-state/snapshot. Spec §6.2 fixes this as 5000 by default; bounded
# 100..50000 to keep response time predictable. SDK pages with ?cursor= until
# the response carries `truncated: false`.
OWN_STATE_SNAPSHOT_MAX_COMMITMENTS=5000
