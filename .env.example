# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Network — must be one of: polygon, amoy
NETWORK=polygon

# Supabase — required at boot
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# RPC — optional today; becomes required when on-chain endpoints land
ALCHEMY_RPC_URL=

# Contracts — optional today; format-validated when set; required when
# EIP-712 endpoints land
MATCHING_MODULE_ADDRESS=
