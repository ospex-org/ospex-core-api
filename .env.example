# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Network — must be one of: polygon, amoy
NETWORK=polygon

# Supabase — required at boot
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# RPC — optional today; becomes required when on-chain endpoints land
ALCHEMY_RPC_URL=

# MatchingModule — required by POST /v1/commitments (verifyingContract
# of the EIP-712 domain). Format-validated when set.
MATCHING_MODULE_ADDRESS=

# Scorer addresses — required by POST /v1/commitments to map a signed
# commitment's `scorer` field to a market_type. All three must be set
# together; a partial config is rejected at boot.
SCORER_MONEYLINE_ADDRESS=
SCORER_SPREAD_ADDRESS=
SCORER_TOTAL_ADDRESS=
